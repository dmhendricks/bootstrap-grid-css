{
  "name": "bootstrap-grid-only-css",
  "description": "The Bootstrap 5 grid, flex and spacing utilities, compiled to CSS and scoped beneath .bootstrap-wrapper. Zero dependencies.",
  "author": "Daniel M. Hendricks",
  "version": "5.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/css/bootstrap-grid.css",
  "style": "dist/css/bootstrap-grid.css",
  "files": [
    "dist/css",
    "scss",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "css",
    "bootstrap",
    "responsive",
    "grid"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "css:compile": "sass --load-path=node_modules --quiet-deps --style=expanded --source-map scss/bootstrap-grid.scss dist/css/bootstrap-grid.css",
    "css:prefix": "postcss --config postcss.config.mjs --replace dist/css/bootstrap-grid.css",
    "css:rtl": "NODE_ENV=RTL postcss --config postcss.config.mjs --dir dist/css --ext .rtl.css dist/css/bootstrap-grid.css",
    "css:minify": "NODE_ENV=MIN postcss --config postcss.config.mjs --dir dist/css --ext .min.css \"dist/css/*.css\" \"!dist/css/*.min.css\"",
    "build": "npm run css:compile && npm run css:prefix && npm run css:rtl && npm run css:minify",
    "prepublishOnly": "npm run build && npm run check",
    "upgrade:bootstrap": "node scripts/upgrade-bootstrap.ts",
    "dev": "sass --load-path=node_modules --quiet-deps --watch scss/bootstrap-grid.scss dist/css/bootstrap-grid.css",
    "dev:demo": "vite --config vite.config.demo.mjs",
    "build:demo": "vite build --config vite.config.demo.mjs",
    "preview:demo": "vite preview --config vite.config.demo.mjs",
    "typecheck": "tsc --noEmit",
    "check:source": "node scripts/check-source.ts",
    "check:scope": "node scripts/check-scope.ts",
    "check:breakpoints": "node scripts/check-breakpoints.ts",
    "check:parity": "node scripts/check-parity.ts",
    "check": "npm run check:source && npm run check:scope && npm run check:breakpoints && npm run check:parity",
    "test:e2e": "playwright test",
    "test:e2e:live": "PLAYWRIGHT_BASE_URL=https://dmhendricks.github.io/bootstrap-grid-css/ playwright test",
    "test": "npm run typecheck && npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "bootstrap": "5.3.8",
    "cssnano": "^8.0.5",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "rtlcss": "^4.3.0",
    "sass": "^1.102.0",
    "sugar-high": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmhendricks/bootstrap-grid-css.git"
  },
  "bugs": {
    "url": "https://github.com/dmhendricks/bootstrap-grid-css/issues"
  },
  "homepage": "https://dmhendricks.github.io/bootstrap-grid-css/",
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
